# Base de datos
DATABASE_URL=postgresql+asyncpg://erp_user:erp_password@localhost:5432/erp_central

# Redis
REDIS_URL=redis://localhost:6379/0

# RabbitMQ
RABBITMQ_URL=amqp://erp_user:erp_password@localhost:5672/

# JWT
SECRET_KEY=cambia_esto_por_una_clave_segura_de_64_caracteres
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# App
APP_NAME=ERP Hospitalario
APP_ENV=development
DEBUG=true
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# Panel Admin — dominio central (igual que en Laravel)
CENTRAL_DOMAIN=erp.local